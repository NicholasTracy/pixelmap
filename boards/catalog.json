{
  "version": 1,
  "boards": [
    {
      "id": "wled_esp32_default",
      "name": "WLED ESP32 default",
      "mcu": "esp32",
      "default": true,
      "pins": {
        "led_data": [
          16,
          2,
          4,
          13,
          14,
          15,
          18,
          19
        ],
        "led_clock": 14,
        "status_led": 2,
        "status_led_active_high": true,
        "button": 0,
        "audio_ws": 15,
        "audio_sck": 14,
        "audio_sd": 32
      },
      "notes": "Classic WLED-style ESP32 DevKit layout. Status LED shares GPIO 2 with many onboard LEDs. If using APA102, move BCLK (audio_sck) off GPIO 14 when that pin is the LED clock.",
      "defaults": {
        "chipset": "WS2812B",
        "color_order": "GRB",
        "pixel_count": 60,
        "max_ma": 4000
      }
    },
    {
      "id": "wled_esp32s3_default",
      "name": "WLED ESP32-S3 default",
      "mcu": "esp32s3",
      "default": true,
      "pins": {
        "led_data": [
          16,
          21,
          38,
          39,
          40,
          41,
          42,
          1
        ],
        "led_clock": 14,
        "status_led": 48,
        "status_led_active_high": true,
        "button": 0,
        "audio_ws": 4,
        "audio_sck": 5,
        "audio_sd": 6
      },
      "notes": "ESP32-S3 friendly data pins (avoids USB-JTAG straps where possible). Status LED defaults to GPIO 48 (common on S3 DevKits); set to \u22121 if your board has no onboard LED.",
      "defaults": {
        "chipset": "WS2812B",
        "color_order": "GRB",
        "pixel_count": 60,
        "max_ma": 4000
      }
    },
    {
      "id": "wled_esp32_eth",
      "name": "ESP32 + Ethernet (data on GPIO 4)",
      "mcu": "esp32",
      "default": false,
      "pins": {
        "led_data": [
          4,
          16,
          2,
          13,
          14,
          15,
          18,
          19
        ],
        "led_clock": 14,
        "status_led": 2,
        "status_led_active_high": true,
        "button": 0,
        "audio_ws": 15,
        "audio_sck": 32,
        "audio_sd": 33
      },
      "notes": "Keeps LED data off pins commonly claimed by LAN8720 Ethernet. Audio BCLK moved off GPIO 14 to reduce clock conflicts.",
      "defaults": {
        "chipset": "WS2812B",
        "color_order": "GRB",
        "pixel_count": 60,
        "max_ma": 4000
      }
    }
  ]
}
